Items: {
	sample: {
		DisplayName: sample
		Tooltip:
			'''
			Template of an item
			Replacing this tooltip is duty 
			It's snowing on Mt.Fuji
			'''
	}

	catchableaxe: {
		DisplayName: Champion's Axe
		Tooltip: ""
	}

	Nail: {
		DisplayName: Nail
		Tooltip: ""
	}

	Clawline: {
		DisplayName: Clawline
		Tooltip: ""
	}

	BlastPack: {
		DisplayName: Blast Pack
		Tooltip:
			'''
			Sticks to surfaces and explodes after a short delay, launching you away from the blast
			Right click to detonate all of your Blast Packs
			'''
	}

	Laevateinn: {
		DisplayName: Lævateinn
		Tooltip:
			'''
			Click left to swing toward the cursor; each swing costs 10 more life than the previous one
			Damage and burn damage double every 4 seconds of accumulated swing time
			Burns enemies for 1 damage per second for 3 seconds
			Life cost and power stop increasing at 1 life; charge persists until you right click
			Right click to stab and detonate an enemy's remaining burn, healing you for damage dealt
			The stab resets charge even if it misses
			'''
	}

	PaintballUmbrella: {
		DisplayName: Paintball Umbrella
		Tooltip:
			'''
			Blasts a spread of giant paintballs that burst on impact
			Paintballs have a chance to inflict a debuff based on their color
			Carry paint to choose the color
			'''
	}

	Snowballer: {
		DisplayName: Snowballer
		Tooltip:
			'''
			Left click to create a snowball in front of you
			The snowball stays in front of you and grows as you move, up to 10 times its base size
			It damages enemies that touch it
			Left click again to throw it toward the cursor; larger snowballs deal more damage and fly faster
			Large thrown snowballs split into smaller snowballs when they hit an enemy or the ground
			Impacts create a snow burst that grows with the snowball's size
			Custom sounds play when snowballs hit enemies or break
			A sound plays when the snowball reaches maximum size
			'''
	}

	Slushballer: {
		DisplayName: Slushballer
		Tooltip:
			'''
			A heavier Snowballer with 2.5 times the damage
			Grows up to 3 times larger while reaching maximum size over the same horizontal travel distance
			'''
	}

	EokaPistol: {
		DisplayName: Eoka Pistol
		Tooltip:
			'''
			Each shot has a 5% chance to fire instantly; otherwise it takes 1-9 ignition attempts, usually 2-3
			Each attempt takes one use time
			Fires a damaging cone in the locked aim direction and kicks you backward
			Damage falls linearly after 9 blocks, reaching zero at maximum range
			'''
	}

	RandomHandgun: {
		DisplayName: Random Handgun
		Tooltip:
			'''
			Changes to a different weapon profile when its shots run out
			Each profile has its own damage, fire rate, and magazine
			'''
		CurrentWeapon: Current: {0} ({1} shots left)
		Rolling: Rolling: {0}
		Equipped: Equipped: {0}
		Glock: Glock
		UMP: UMP
		AWP: AWP
		AK-47: AK-47
		Knife: Knife
	}

	SharkStaff: {
		DisplayName: Shark Staff
		Tooltip: Summons a shark that blows bubbles at nearby enemies
	}
}

