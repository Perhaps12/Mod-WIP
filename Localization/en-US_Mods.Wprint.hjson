	Clawline: {
		DisplayName: Clawline
		Tooltip: ""
	}

	BlastPack: {
		DisplayName: Blast Pack
		Tooltip:
			'''
			Sticks to surfaces and explodes after a short delay, launching you away from the blast
			Right click to detonate all of your Blast Packs
			'''
	}

	Laevateinn: {
		DisplayName: Lævateinn
		Tooltip:
			'''
			Click left to swing toward the cursor; each swing costs 10 more life than the previous one
			Damage and burn damage double every 4 seconds of accumulated swing time
			Burns enemies for 1 damage per second for 3 seconds
			Life cost and power stop increasing at 1 life; charge persists until you right click
			Right click to stab and detonate an enemy's remaining burn, healing you for damage dealt
			The stab resets charge even if it misses
			'''
	}
}

Projectiles: {
	catchableaxeProjectile.DisplayName: catchableaxe Projectile
